# LLM: choose anthropic or openai and set the matching key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Required when LLM_PROVIDER=openai
OPENAI_MODEL=
# Optional. Some models need "none" to use tools on Chat Completions.
OPENAI_REASONING_EFFORT=

# Keys the hashes of client IDs and IPs. Set a long random value outside local use.
APP_SECRET=local-dev-secret-change-me
# Protects GET /admin/flags. The endpoint is disabled while this is empty.
ADMIN_TOKEN=

# Optional: receives a POST for each risk alert
ALERT_WEBHOOK_URL=
# Set to true to run the daily refresh inside the API process
ENABLE_SCHEDULER=false
# Set to true only when the API sits behind the UI or a proxy you control
TRUST_FORWARDED_FOR=true

API_URL=http://127.0.0.1:8000
DB_PATH=data/weather_risk.db
